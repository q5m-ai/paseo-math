{
  "name": "@q5m-ai/paseo-math",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Markdown and LaTeX rendering for Paseo 0.8",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:q5m-ai/paseo-math",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sdk": "node scripts/sdk.mjs",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "smoke:hermes": "node --import tsx scripts/hermes-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "markdown-it": "15.0.1",
    "mathjax-full": "3.2.2",
    "react-native-markdown-display": "7.0.2"
  },
  "overrides": {
    "react-native-markdown-display": {
      "markdown-it": "$markdown-it"
    },
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-classes": "7.28.6",
    "@getpaseo/plugin": "0.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "zod": "4.4.3"
  }
}
